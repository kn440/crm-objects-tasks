# Supabase → Connect (или Project Settings → API Keys)
# Публичные значения: попадают в браузер, это нормально.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# (подойдёт и старый anon key: VITE_SUPABASE_ANON_KEY=...)

# Только для npm run security-check (локально, в репозиторий не попадает).
# Секретный ключ (secret / service_role) здесь НЕ нужен и нигде не используется.
CHECK_MANAGER_EMAIL=manager@test.ru
CHECK_MANAGER_PASSWORD=
CHECK_WORKER1_EMAIL=worker1@test.ru
CHECK_WORKER1_PASSWORD=
CHECK_WORKER2_EMAIL=worker2@test.ru
CHECK_WORKER2_PASSWORD=
